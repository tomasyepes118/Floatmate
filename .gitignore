**/storage/framework/cache/data/*
**/storage/framework/views/*
**/storage/app/demo/*
**/storage/logs/*
**/.phpunit.cache/
**/test-results/
**/playwright-report/
*.log
!**/.gitkeep

# Paquetes y respaldos locales
*.zip
*.backup
*.dump
