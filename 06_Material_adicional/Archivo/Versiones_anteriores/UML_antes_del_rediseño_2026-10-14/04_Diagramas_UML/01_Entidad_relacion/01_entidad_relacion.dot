digraph FloatMate { graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="1.1", fontname="Arial", splines=spline]; node [fontname="Arial", fontsize=12, color="#94a3b8"]; edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#334155", arrowsize=0.7];

usuarios [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>usuarios</B></TD></TR><TR><TD ALIGN="LEFT">PK usuario_id<BR ALIGN="LEFT"/> terminal_codigo<BR ALIGN="LEFT"/>UQ documento<BR ALIGN="LEFT"/> nombres<BR ALIGN="LEFT"/>UQ correo<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
conductores [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>conductores</B></TD></TR><TR><TD ALIGN="LEFT">PK conductor_id<BR ALIGN="LEFT"/> terminal_codigo<BR ALIGN="LEFT"/>UQ documento<BR ALIGN="LEFT"/> nombres<BR ALIGN="LEFT"/>UQ numero_licencia<BR ALIGN="LEFT"/> estado<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
vehiculos [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>vehiculos</B></TD></TR><TR><TD ALIGN="LEFT">PK vehiculo_id<BR ALIGN="LEFT"/> terminal_codigo<BR ALIGN="LEFT"/>UQ placa<BR ALIGN="LEFT"/>UQ codigo_interno<BR ALIGN="LEFT"/> tipo<BR ALIGN="LEFT"/> estado<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
rutas [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>rutas</B></TD></TR><TR><TD ALIGN="LEFT">PK ruta_id<BR ALIGN="LEFT"/> terminal_codigo<BR ALIGN="LEFT"/>UQ codigo<BR ALIGN="LEFT"/> nombre<BR ALIGN="LEFT"/> tipo<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
viajes [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>viajes</B></TD></TR><TR><TD ALIGN="LEFT">PK viaje_id<BR ALIGN="LEFT"/> terminal_codigo<BR ALIGN="LEFT"/>FK vehiculo_id<BR ALIGN="LEFT"/>FK conductor_id<BR ALIGN="LEFT"/>FK ruta_id<BR ALIGN="LEFT"/> fecha_hora_programada<BR ALIGN="LEFT"/> estado<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
controles_salida [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>controles_salida</B></TD></TR><TR><TD ALIGN="LEFT">PK control_id<BR ALIGN="LEFT"/> terminal_codigo<BR ALIGN="LEFT"/>FK UQ viaje_id<BR ALIGN="LEFT"/>FK usuario_id<BR ALIGN="LEFT"/>UQ numero_ticket<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
abastecimientos [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>abastecimientos</B></TD></TR><TR><TD ALIGN="LEFT">PK abastecimiento_id<BR ALIGN="LEFT"/> terminal_codigo<BR ALIGN="LEFT"/>FK vehiculo_id<BR ALIGN="LEFT"/>FK viaje_id<BR ALIGN="LEFT"/>FK usuario_id<BR ALIGN="LEFT"/>UQ numero_factura<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
mantenimientos [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>mantenimientos</B></TD></TR><TR><TD ALIGN="LEFT">PK mantenimiento_id<BR ALIGN="LEFT"/> terminal_codigo<BR ALIGN="LEFT"/>FK vehiculo_id<BR ALIGN="LEFT"/>FK usuario_id<BR ALIGN="LEFT"/> tipo<BR ALIGN="LEFT"/> estado<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
incidentes [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>incidentes</B></TD></TR><TR><TD ALIGN="LEFT">PK incidente_id<BR ALIGN="LEFT"/> terminal_codigo<BR ALIGN="LEFT"/>FK viaje_id<BR ALIGN="LEFT"/>FK usuario_id<BR ALIGN="LEFT"/> tipo<BR ALIGN="LEFT"/> estado<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
vehiculos -> viajes [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
conductores -> viajes [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
rutas -> viajes [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
viajes -> controles_salida [dir=none,taillabel="1",headlabel="0..1",labeldistance=2.1];
usuarios -> controles_salida [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
vehiculos -> abastecimientos [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
viajes -> abastecimientos [dir=none,taillabel="0..1",headlabel="0..*",labeldistance=2.1];
usuarios -> abastecimientos [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
vehiculos -> mantenimientos [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
usuarios -> mantenimientos [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
viajes -> incidentes [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
usuarios -> incidentes [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
}