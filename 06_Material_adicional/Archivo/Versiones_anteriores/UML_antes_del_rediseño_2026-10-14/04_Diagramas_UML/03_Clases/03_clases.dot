digraph FloatMate { graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="1.1", fontname="Arial", splines=spline]; node [fontname="Arial", fontsize=12, color="#94a3b8"]; edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#334155", arrowsize=0.7];

usuarios [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT">- usuario_id: Long<BR ALIGN="LEFT"/>- documento: String<BR ALIGN="LEFT"/>- nombres: String<BR ALIGN="LEFT"/>- apellidos: String<BR ALIGN="LEFT"/>- correo: String<BR ALIGN="LEFT"/>- rol: String<BR ALIGN="LEFT"/>- activo: Boolean<BR ALIGN="LEFT"/>- creado_en: DateTime<BR ALIGN="LEFT"/>- terminal_codigo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ puedeOperar(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
conductores [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>Conductor</B></TD></TR><TR><TD ALIGN="LEFT">- conductor_id: Long<BR ALIGN="LEFT"/>- nombres: String<BR ALIGN="LEFT"/>- numero_licencia: String<BR ALIGN="LEFT"/>- categoria_licencia: String<BR ALIGN="LEFT"/>- licencia_vence: Date<BR ALIGN="LEFT"/>- telefono: String<BR ALIGN="LEFT"/>- estado: String<BR ALIGN="LEFT"/>- terminal_codigo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ estaDisponible(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
vehiculos [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>Vehiculo</B></TD></TR><TR><TD ALIGN="LEFT">- vehiculo_id: Long<BR ALIGN="LEFT"/>- placa: String<BR ALIGN="LEFT"/>- tipo: String<BR ALIGN="LEFT"/>- capacidad_pasajeros: Integer<BR ALIGN="LEFT"/>- kilometraje: Decimal<BR ALIGN="LEFT"/>- proximo_mantenimiento_km: Decimal<BR ALIGN="LEFT"/>- estado: String<BR ALIGN="LEFT"/>- terminal_codigo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ kilometrosParaMantenimiento(): Decimal<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
rutas [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>Ruta</B></TD></TR><TR><TD ALIGN="LEFT">- ruta_id: Long<BR ALIGN="LEFT"/>- codigo: String<BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- origen: String<BR ALIGN="LEFT"/>- destino: String<BR ALIGN="LEFT"/>- tipo: String<BR ALIGN="LEFT"/>- distancia_km: Decimal<BR ALIGN="LEFT"/>- duracion_minutos: Integer<BR ALIGN="LEFT"/>- activa: Boolean<BR ALIGN="LEFT"/>- terminal_codigo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ estaActiva(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
viajes [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>Viaje</B></TD></TR><TR><TD ALIGN="LEFT">- viaje_id: Long<BR ALIGN="LEFT"/>- fecha_hora_programada: DateTime<BR ALIGN="LEFT"/>- pasajeros: Integer<BR ALIGN="LEFT"/>- estado: String<BR ALIGN="LEFT"/>- terminal_codigo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ iniciar(): void<BR ALIGN="LEFT"/>+ finalizar(kmFinal: Decimal): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
controles_salida [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>ControlSalida</B></TD></TR><TR><TD ALIGN="LEFT">- control_id: Long<BR ALIGN="LEFT"/>- fecha_hora_control: DateTime<BR ALIGN="LEFT"/>- alcoholemia_mg_l: Decimal<BR ALIGN="LEFT"/>- resultado: String<BR ALIGN="LEFT"/>- numero_ticket: String<BR ALIGN="LEFT"/>- observaciones: String [0..1]<BR ALIGN="LEFT"/>- terminal_codigo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ esAprobado(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
abastecimientos [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>Abastecimiento</B></TD></TR><TR><TD ALIGN="LEFT">- abastecimiento_id: Long<BR ALIGN="LEFT"/>- fecha_hora: DateTime<BR ALIGN="LEFT"/>- litros: Decimal<BR ALIGN="LEFT"/>- valor_litro: Decimal<BR ALIGN="LEFT"/>- valor_total: Decimal<BR ALIGN="LEFT"/>- kilometraje: Decimal<BR ALIGN="LEFT"/>- terminal_codigo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ calcularTotal(): Decimal<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
mantenimientos [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>Mantenimiento</B></TD></TR><TR><TD ALIGN="LEFT">- mantenimiento_id: Long<BR ALIGN="LEFT"/>- tipo: String<BR ALIGN="LEFT"/>- fecha_ingreso: Date<BR ALIGN="LEFT"/>- fecha_salida: Date [0..1]<BR ALIGN="LEFT"/>- kilometraje: Decimal<BR ALIGN="LEFT"/>- costo: Decimal<BR ALIGN="LEFT"/>- proveedor: String<BR ALIGN="LEFT"/>- descripcion: String<BR ALIGN="LEFT"/>- estado: String<BR ALIGN="LEFT"/>- terminal_codigo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ finalizar(fecha: Date): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
incidentes [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eaf4f2"><B>Incidente</B></TD></TR><TR><TD ALIGN="LEFT">- incidente_id: Long<BR ALIGN="LEFT"/>- fecha_hora: DateTime<BR ALIGN="LEFT"/>- tipo: String<BR ALIGN="LEFT"/>- severidad: String<BR ALIGN="LEFT"/>- descripcion: String<BR ALIGN="LEFT"/>- ubicacion: String<BR ALIGN="LEFT"/>- tiene_evidencia: Boolean<BR ALIGN="LEFT"/>- estado: String<BR ALIGN="LEFT"/>- terminal_codigo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ cerrar(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
vehiculos -> viajes [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
conductores -> viajes [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
rutas -> viajes [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
viajes -> controles_salida [dir=none,taillabel="1",headlabel="0..1",labeldistance=2.1];
usuarios -> controles_salida [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
vehiculos -> abastecimientos [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
viajes -> abastecimientos [dir=none,taillabel="0..1",headlabel="0..*",labeldistance=2.1];
usuarios -> abastecimientos [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
vehiculos -> mantenimientos [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
usuarios -> mantenimientos [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
viajes -> incidentes [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
usuarios -> incidentes [dir=none,taillabel="1",headlabel="0..*",labeldistance=2.1];
}