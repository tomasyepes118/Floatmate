digraph FloatMate { graph [rankdir=LR, bgcolor="white", pad="0.08", nodesep="0.09", ranksep="0.28", fontname="Arial", splines=spline]; node [height=0,margin="0.03,0.015",fontname="Arial", fontsize=11, color="#94a3b8"]; edge [fontname="Arial", fontsize=11, color="#64748b", fontcolor="#334155", arrowsize=0.7];
subgraph cluster_sistema { label="Sistema FloatMate"; color="#0f766e"; penwidth=1.4;
login [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU01\nIniciar sesión"];
panel [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU02\nConsultar panel y reportes"];
vehiculos [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU03\nGestionar vehículos"];
conductores [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU04\nGestionar conductores"];
rutas [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU05\nGestionar rutas"];
usuarios [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU06\nGestionar usuarios"];
programar [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU07\nProgramar viaje"];
validar [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU08\nValidar asignación"];
control [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU09\nRegistrar control de salida"];
iniciar [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU10\nIniciar viaje"];
habilitar [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU11\nVerificar salida habilitada"];
cerrar [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU12\nFinalizar viaje"];
combustible [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU13\nRegistrar abastecimiento"];
mantenimiento [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU14\nRegistrar mantenimiento"];
incidente [shape=ellipse,style=filled,fillcolor="#f1f8f6",label="CU15\nRegistrar incidente"];
}
consulta [shape=box,label="«actor»
Consulta"];
operador [shape=box,label="«actor»
Operador"];
admin [shape=box,label="«actor»
Administrador"];
{rank=same; admin; operador; consulta;}
operador -> consulta [constraint=false,arrowhead=empty,label="hereda"];
admin -> operador [constraint=false,arrowhead=empty,label="hereda"];
consulta -> login [dir=none];
consulta -> panel [dir=none];
operador -> programar [dir=none];
operador -> control [dir=none];
operador -> iniciar [dir=none];
operador -> cerrar [dir=none];
operador -> combustible [dir=none];
operador -> mantenimiento [dir=none];
operador -> incidente [dir=none];
admin -> vehiculos [dir=none];
admin -> conductores [dir=none];
admin -> rutas [dir=none];
admin -> usuarios [dir=none];
programar -> validar [style=dashed,arrowhead=vee,label="«include»"];
iniciar -> habilitar [style=dashed,arrowhead=vee,label="«include»"];
}